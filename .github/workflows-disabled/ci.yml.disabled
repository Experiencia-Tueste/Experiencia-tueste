# CI LOCAL TEMPORAL — WORKFLOW DESACTIVADO
# ---------------------------------------------------------------------------
# Este workflow está desactivado temporalmente por el bloqueo externo de
# facturación de GitHub Actions en la cuenta (falla antes de iniciar runner,
# no por el código).
#
# El reemplazo temporal es `npm run verify`, ejecutado localmente.
#
# NO BORRAR: se restaurará a .github/workflows/ci.yml cuando GitHub Actions
# esté disponible de nuevo.
# ---------------------------------------------------------------------------

name: CI

on:
  push:
  pull_request:

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node (desde .nvmrc)
        uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm

      - name: Instalar dependencias
        run: npm ci

      - name: Lint
        run: npm run lint

      - name: Formato
        run: npm run format:check

      - name: Typecheck
        run: npm run typecheck

      - name: Tests
        run: npm test

      - name: Build
        run: npm run build
