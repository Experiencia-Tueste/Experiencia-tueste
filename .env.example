# Variables de entorno de Tueste (contrato único en src/lib/config/env.ts).
# Copia este archivo a `.env.local` y completa los valores cuando actives
# la persistencia real (Supabase). Nunca subas claves reales al repo.
#
# Modo demo: si ambas variables están vacías o ausentes, la app funciona
# sin servicios (loadPublicConfig devuelve null). Si solo una existe, o
# la URL no es válida, la app lanza un error claro de configuración.
# No uses service role keys ni variables privadas aquí: solo públicas.

# URL del proyecto Supabase (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canónica del sitio (NO es secreto). Sirve para canonical URL,
# Open Graph y Twitter (metadataBase). En desarrollo/build local se usa
# http://localhost:3000 como fallback si está vacía. En Railway,
# reemplázala por el dominio público HTTPS real antes de producción.
SITE_URL=http://localhost:3000

# URL pública de la tienda Tueste Co (Shopify) para el portal de entrada.
# NO es secreto: es el enlace público de la tienda. Debe ser una URL
# absoluta https:// (p. ej. https://tueste.myshopify.com). Si está vacía
# o ausente, la tarjeta Tienda del portal muestra «Tienda próximamente»
# en lugar de un enlace roto. Un valor inválido lanza un error claro de
# configuración que menciona SHOPIFY_STORE_URL.
SHOPIFY_STORE_URL=

# ── Panel administrativo (server-only) ──────────────────────────────────
# SECRETOS del panel: NUNCA con prefijo NEXT_PUBLIC_, nunca en el bundle
# cliente, nunca en este archivo con valores reales. Sin estos valores,
# el panel queda cerrado (fail closed): nadie puede autenticarse.

# Secreto de sesión de Auth.js (requerido si Google está configurado).
AUTH_SECRET=

# Credenciales de Google OAuth/OIDC. Deben definirse AMBAS juntas; si
# solo existe una, el panel lanza un error claro de configuración.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# Conexión privada de PostgreSQL de Supabase para el panel administrativo.
# Nunca usar NEXT_PUBLIC_, anon key o service role aquí. Solo se define
# localmente en .env.local (nunca se sube al repositorio).
DATABASE_URL=

# Storage privado para activos del panel. Opcional en desarrollo; si
# defines una, debes definir las tres. La key privada nunca va al
# navegador ni debe tener prefijo NEXT_PUBLIC_.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_ADMIN_KEY=
SUPABASE_STORAGE_BUCKET=tueste-admin-assets

# ── BFF de pagos (server-only) ──────────────────────────────────────────
# Next.js firma un JWT RS256 de vida corta para hablar con el servicio
# privado Spring. La clave privada solo vive en el servicio web de Railway.
PAYMENTS_SERVICE_URL=http://localhost:8080
PAYMENTS_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PAYMENTS_JWT_KEY_ID=tueste-web-2026-01
PAYMENTS_JWT_ISSUER=tueste-web
PAYMENTS_JWT_AUDIENCE=tueste-payments
PAYMENTS_REQUEST_TIMEOUT_MS=8000
